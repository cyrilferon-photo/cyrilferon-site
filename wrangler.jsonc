// Configuration Cloudflare Workers du site cyrilferon.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyrilferon",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Fichiers du site servis tels quels (voir .assetsignore pour ceux qui restent privés)
  "assets": { "directory": ".", "binding": "ASSETS" },
  // Base de données du site (contenu publié, stocks, commandes, photos du back office, messages)
  "durable_objects": { "bindings": [{ "name": "SITE", "class_name": "SiteStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteStore"] }],
  "observability": { "enabled": true }
}
